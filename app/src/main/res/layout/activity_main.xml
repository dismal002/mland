<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dismal.marshmallowland.MLand
        android:id="@+id/world"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/welcome"
        android:background="#a0000000"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/play_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.andexert.library.RippleView
                android:id="@+id/more"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="startButtonPressed"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/play_button_image"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ripple"
                android:scaleType="fitCenter"
                android:alpha="0"/>
            <TextView
                android:textSize="40dp"
                android:textColor="#fafafa"
                android:layout_gravity="center"
                android:id="@+id/tap_to_play_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/taptoplay"
                android:alpha="0.6"/>
            <TextView
                android:textSize="40dp"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:id="@+id/play_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top|left"
        android:orientation="horizontal"
        android:id="@+id/player_setup"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:alpha="0">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/scores"
            android:padding="12dp"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/bonus_view"
            android:layout_width="55dp"
            android:layout_height="80dp"
            android:alpha="0">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/bonus_img"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_marginTop="30dp"
                android:src="@drawable/scorecard"/>
            <TextView
                android:textSize="20dp"
                android:layout_gravity="center_horizontal"
                android:id="@+id/bonus_text"
                android:layout_width="35dp"
                android:layout_height="40dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="35dp"
                android:scaleType="fitCenter"
                android:text="+2"
                android:singleLine="false"
                android:textAlignment="center"/>
        </FrameLayout>
    </LinearLayout>
    <com.github.clans.fab.FloatingActionMenu
        android:id="@+id/menu2"
        android:paddingLeft="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        app:menu_labels_ellipsize="end"
        app:menu_labels_singleLine="true">
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_about"
            app:fab_colorNormal="#9c27b0"
            app:fab_colorPressed="#9c27b0"
            app:fab_label="About"
            app:fab_size="normal"/>
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sound"
            app:fab_colorNormal="#03a9f4"
            app:fab_colorPressed="#03a9f4"
            app:fab_label="Sound"
            app:fab_size="normal"/>
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_easy_level"
            app:fab_colorNormal="#4caf50"
            app:fab_colorPressed="#4caf50"
            app:fab_label="Difficulty"
            app:fab_size="normal"/>
    </com.github.clans.fab.FloatingActionMenu>
</FrameLayout>
